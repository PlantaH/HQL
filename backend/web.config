<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <outboundRules>
				<preConditions>
					<preCondition name="ResponseIsHtml1">
						<add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
					</preCondition>
				</preConditions>
			</outboundRules>
			<rules>
				<rule name="mis-datos/" stopProcessing="false">
                    <match url="^mis-datos/" />
                    <action type="Rewrite" url="mis-datos.asp" appendQueryString="false" logRewrittenUrl="false" />
                </rule>
				<rule name="principal/" stopProcessing="false">
                    <match url="^principal/" />
                    <action type="Rewrite" url="principal.asp" appendQueryString="true" logRewrittenUrl="true" />
                </rule>
				
				<rule name="parametros/" stopProcessing="false">
                    <match url="^parametros/" />
                    <action type="Rewrite" url="par_parametros_principal.asp" appendQueryString="false" logRewrittenUrl="false" />
                </rule>
				
				<rule name="usuarios/" stopProcessing="false">
                    <match url="^usuarios/" />
                    <action type="Rewrite" url="usr_usuarios_principal.asp?tipo=USR" appendQueryString="false" logRewrittenUrl="false" />
                </rule>
				<rule name="usuarios-nuevo/" stopProcessing="false">
                    <match url="^usuarios-nuevo/" />
                    <action type="Rewrite" url="usr_usuarios_altamodi.asp" appendQueryString="false" logRewrittenUrl="false" />
                </rule>
				
				<rule name="usuarios-modi/" stopProcessing="false">
                    <match url="^usuarios-modi/([_0-9a-z-]+)/([_0-9a-z-]+)/" />
                    <action type="Rewrite" url="usr_usuarios_altamodi.asp?id={R:1}&amp;pN={R:2}" appendQueryString="false" logRewrittenUrl="false" />
                </rule>
				<rule name="usuarios-baja/" stopProcessing="false">
                    <match url="^usuarios-baja/([_0-9a-z-]+)/([_0-9a-z-]+)/" />
                    <action type="Rewrite" url="usr_usuarios_baja.asp?id={R:1}&amp;pN={R:2}" appendQueryString="false" logRewrittenUrl="false" />
                </rule>
				<rule name="usuarios-permisos/" stopProcessing="false">
                    <match url="^usuarios-permisos/([_0-9a-z-]+)/([_0-9a-z-]+)/" />
                    <action type="Rewrite" url="usr_usuarios_permisos.asp?id={R:1}&amp;pN={R:2}" appendQueryString="false" logRewrittenUrl="false" />
                </rule>
				  
				 
				
				<rule name="login/" stopProcessing="false">
                    <match url="^login/" />
                    <action type="Rewrite" url="login.asp" appendQueryString="false" logRewrittenUrl="false" />
                </rule>
				 		
                <rule name="registro/" stopProcessing="false">
                    <match url="^registro/" />
                    <action type="Rewrite" url="registro.asp" appendQueryString="false" logRewrittenUrl="false" />
                </rule>
				 
				
				 
				
				<rule name="productos/" stopProcessing="false">
					<match url="^productos/" />
					<action type="Rewrite" url="pro_productos_principal.asp" appendQueryString="false" logRewrittenUrl="false" />
				</rule>
				<rule name="productos-nuevo/" stopProcessing="false">
					<match url="^productos-nuevo/" />
					<action type="Rewrite" url="pro_productos_altamodi.asp" appendQueryString="false" logRewrittenUrl="false" />
				</rule>
				<rule name="productos-modi/" stopProcessing="false">
					<match url="^productos-modi/([_0-9a-z-]+)/([_0-9a-z-]+)/" />
					<action type="Rewrite" url="pro_productos_altamodi.asp?id={R:1}&amp;pN={R:2}" appendQueryString="false" logRewrittenUrl="false" />
				</rule>
				<rule name="productos-baja/" stopProcessing="false">
					<match url="^productos-baja/([_0-9a-z-]+)/([_0-9a-z-]+)/" />
					<action type="Rewrite" url="pro_productos_baja.asp?id={R:1}&amp;pN={R:2}" appendQueryString="false" logRewrittenUrl="false" />
				</rule>
				
				<rule name="entrada/" stopProcessing="false">
					<match url="^entrada/([_0-9a-z-]+)/" />
					<action type="Rewrite" url="pro_leidas.asp?t={R:1}&amp;modo=E" appendQueryString="false" logRewrittenUrl="false" />
				</rule>
				<rule name="salida/" stopProcessing="false">
					<match url="^salida/([_0-9a-z-]+)/" />
					<action type="Rewrite" url="pro_leidas.asp?t={R:1}&amp;modo=S" appendQueryString="false" logRewrittenUrl="false" />
				</rule>
				
				<rule name="rpt_1/" stopProcessing="false">
					<match url="^rpt_1/" />
					<action type="Rewrite" url="rpt_reporte_estadistica.asp?t=1" appendQueryString="false" logRewrittenUrl="false" />
				</rule>
				<rule name="rpt_2/" stopProcessing="false">
					<match url="^rpt_2/" />
					<action type="Rewrite" url="rpt_reporte_estadistica.asp?t=2" appendQueryString="false" logRewrittenUrl="false" />
				</rule>
				<rule name="rpt_3/" stopProcessing="false">
					<match url="^rpt_3/" />
					<action type="Rewrite" url="rpt_reporte_estadistica.asp?t=3" appendQueryString="false" logRewrittenUrl="false" />
				</rule>
				
				
				<rule name="entradastock/" stopProcessing="false">
					<match url="^entradastock/([_0-9a-z-]+)/" />
					<action type="Rewrite" url="pro_entrada_stock.asp?t={R:1}&amp;modo=E" appendQueryString="false" logRewrittenUrl="false" />
				</rule>
				
				<rule name="cargastock/" stopProcessing="false">
					<match url="^cargastock/" />
					<action type="Rewrite" url="pro_carga_stock.asp" appendQueryString="false" logRewrittenUrl="false" />
				</rule>
				
				<rule name="salidastock/" stopProcessing="false">
					<match url="^salidastock/([_0-9a-z-]+)/" />
					<action type="Rewrite" url="pro_salida_stock.asp?t={R:1}&amp;modo=S" appendQueryString="false" logRewrittenUrl="false" />
				</rule>
				<rule name="descargastock/" stopProcessing="false">
					<match url="^descargastock/" />
					<action type="Rewrite" url="pro_descarga_stock.asp" appendQueryString="false" logRewrittenUrl="false" />
				</rule>
            </rules>
        </rewrite>
		<staticContent>
			<remove fileExtension=".woff" />
			<mimeMap fileExtension=".woff" mimeType="application/x-font-woff" />
            <remove fileExtension=".woff2" />
			<mimeMap fileExtension=".woff2" mimeType="application/x-font-woff2" />    				
		</staticContent>
        <httpErrors>
            <remove statusCode="500" subStatusCode="-1" />
            <error statusCode="500" prefixLanguageFilePath="" path="/Conectta/showerror.asp" responseMode="ExecuteURL" />
            <error statusCode="500" subStatusCode="100" path="/Conectta/showerror.asp" responseMode="ExecuteURL" />
        </httpErrors>
    </system.webServer>
</configuration>
