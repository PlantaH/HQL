Function CargarDiccionario()
	Set XMLdoc = Server.CreateObject("Microsoft.XMLDOM")
	XMLdoc.async = false	
	XMLdoc.load(Application("MapPath") & "\includes\diccionario.xml")	
	Application("XMLDictionario") = XMLdoc.xml	
